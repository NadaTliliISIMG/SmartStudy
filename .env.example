# ===== Backend =====
NODE_ENV=development
BACKEND_PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/smartstudy
JWT_SECRET=change_me_with_a_long_random_string
JWT_EXPIRES_IN=7d
AI_SERVICE_URL=http://ai-service:8000
AI_TIMEOUT_MS=120000
CORS_ORIGIN=http://localhost:3000

# ===== AI service =====
AI_PORT=8000
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=120

# ===== Frontend =====
VITE_API_URL=http://localhost:5000/api

# ===== MongoDB =====
MONGO_INITDB_DATABASE=smartstudy

# ===== Docker Compose (docker compose up --build) =====
# JWT_SECRET above is REQUIRED by Compose.
# Containers use their own service names (mongo, ai-service), so MONGO_URI and
# AI_SERVICE_URL above are only used when you run the services without Docker.
# Optional override if Ollama is not on the Docker host:
# DOCKER_OLLAMA_URL=http://host.docker.internal:11434